# ---------------------------------------------------------------------------
# Leon Blog environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Runtime vs migration connections are intentionally separate (architecture §18).
# ---------------------------------------------------------------------------

# ---- Runtime (application server components / route handlers) ----
# Pooled connection URL (Neon uses its pooler host; local uses Docker PG).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leon_blog?schema=public"

# Auth.js encryption secret for the JWT session cookie. At least 32 chars.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Public site URL — used for canonical / sitemap / OG absolute URLs.
NEXT_PUBLIC_SITE_URL="https://blog.example.com"

# Public site name — used in metadata and JSON-LD.
NEXT_PUBLIC_SITE_NAME="Leon 的博客"

# Comma-separated HTTPS image host whitelist (cover, SEO share, Markdown images).
# Same list drives next.config `images.remotePatterns` and the image URL policy.
ALLOWED_IMAGE_HOSTS="images.example.com,avatars.githubusercontent.com"

# ---- Prisma CLI / CI migrations (direct connection, not pooled) ----
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leon_blog?schema=public"

# ---- Integration tests only (isolated database, never the production one) ----
# Points at the dedicated postgres-test container (docker-compose maps 5433).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/leon_blog_test?schema=public"

# ---- One-time local seed bootstrap ----
# Only read by `prisma db seed`. Create the first admin once, then REMOVE these
# two variables. Never keep bootstrap credentials in production env vars.
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD=""
