# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
# NOTE: next-env.d.ts is intentionally NOT ignored — the Next.js template
# convention is to commit it (it imports ./.next/types/*.d.ts, generated by
# `next typegen` / `next build`; CI runs typegen before typecheck).

# production
/build

# generated prisma client (regenerate via pnpm prisma:generate)
/src/generated/prisma/

# env & secrets
.env
.env*.local
.env.development
.env.production
!.env.example

# testing
/coverage
/playwright-report
/test-results
/vitest-report

# local ephemeral postgres data dir (embedded-postgres verification)
/.tmp-pgdata/

# local scratch: Feishu API dumps, QA screenshots, agent skills
/.tmp-feishu/
/qa-*.png
/.agents/
/skills-lock.json

# IDE
.vscode/

# misc
.DS_Store
*.pem

# stray zero-byte temp files (e.g. _tmp_15_*, _tmp_21_*)
_tmp_*

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# typescript
*.tsbuildinfo

# internal audit / delivery artifacts (not for public repo)
/.agent-os/
/delivery/

# temporary local-only integration config
/vitest.integration.local.config.ts
